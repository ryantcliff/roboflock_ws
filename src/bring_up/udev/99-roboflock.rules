# Stable device names for the robot's serial devices.
# Install: sudo cp 99-roboflock.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger

# SparkFun GPS-RTK2 (u-blox ZED-F9P), native USB -> /dev/ublox_gps
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", MODE="0666", SYMLINK+="ublox_gps"

# RPLidar (CP2102 USB-UART bridge) -> /dev/rplidar_usb
# If the Meshtastic node also uses a CP210x, this needs narrowing by USB port.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE="0666", SYMLINK+="rplidar_usb"
